# ===================================================================
# SalonOS Backend Production Environment Configuration (.env)
# ===================================================================

# 1. Database Connection (PostgreSQL)
# For cPanel PostgreSQL (if available locally):
# DATABASE_URL="postgresql://cpuser_dbuser:password@localhost:5432/cpuser_salon_db"
# For Cloud PostgreSQL (Supabase / Neon / Aiven):
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# 2. Server Configuration
PORT=5000
NODE_ENV=production
TZ=Asia/Karachi

# 3. CORS Configuration (Add your frontend production URLs, comma-separated)
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# 4. Security & JWT Secrets (Change these to long random strings in production!)
JWT_ACCESS_SECRET=replace_with_strong_production_access_secret_2026
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret_2026
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

